# 이 파일을 .env 로 복사한 뒤 채우세요.  cp .env.example .env
# JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY 는 ./gen-keys.sh 가 만들어 줍니다. (.env 는 git 에 올리지 마세요)

# Postgres 비밀번호 (영문+숫자만 권장: 특수문자는 접속 주소에 쓰여서 문제가 될 수 있어요)
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# 앱이 서비스되는 주소 (경로 없이)
SITE_URL=https://solvi.p-e.kr
# Pi 서버의 바깥 HTTPS 주소 (Tailscale Funnel/Cloudflare Tunnel 에서 받은 주소, 경로 없이)
API_URL=https://solvi-pi.tailxxxx.ts.net

# DB·캐시를 저장할 위치 (USB SSD 마운트 경로 권장)
DATA_DIR=/mnt/ssd/solvi

# 이메일 인증: 메일 서버(SMTP)가 없으면 true 로 두세요(가입 즉시 사용 가능).
# SMTP 를 쓰려면 false 로 바꾸고 아래를 채우세요.
MAILER_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
